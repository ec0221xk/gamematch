# Supabaseのプロジェクト設定 > API画面から取得できます
# このファイルをコピーして「.env.local」という名前で保存し、値を入力してください
# 例: cp .env.local.example .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。Supabaseプロジェクト設定 > API画面から取得できます
# (NEXT_PUBLIC_を付けない = ブラウザに公開されない値)
SUPABASE_SERVICE_ROLE_KEY=

# サーバー専用。Resendダッシュボード > API Keysから取得できます
RESEND_API_KEY=
